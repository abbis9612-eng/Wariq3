{
  "name": "wariq-intercept-prototype",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "models": "node tools/glb2json.mjs models/kh101.glb models/kh101.gltf.json && node tools/glb2json.mjs models/patriot.glb models/patriot.gltf.json",
    "dev": "npm run models && vite",
    "build": "npm run models && vite build",
    "typecheck": "tsc --noEmit",
    "test:sim": "node tools/simtest.ts",
    "test:scene": "node tools/scene-shots.mjs \"http://localhost:5173/index.html?auto=1&q=low\" ./shots 390 844"
  },
  "dependencies": {
    "@babylonjs/core": "9.33.1",
    "@babylonjs/loaders": "9.33.1",
    "@babylonjs/materials": "9.33.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}